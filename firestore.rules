rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function blockedEither(a, b) { return exists(/databases/$(database)/documents/blocks/$(a)/list/$(b)) || exists(/databases/$(database)/documents/blocks/$(b)/list/$(a)); }
    function db() { return /databases/$(database)/documents; }
    function areFriends(a, b) { return exists(/databases/$(database)/documents/friends/$(a)/list/$(b)); }

    // public profile: handle, display name, emoji. Searchable by any signed-in user.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['handle','name','emoji','ts','bio','cv','ph'])
        && (!('ph' in request.resource.data) || (request.resource.data.ph is string && request.resource.data.ph.size() <= 36000))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('cv' in request.resource.data) || (request.resource.data.cv is int && request.resource.data.cv >= 0 && request.resource.data.cv < 6))
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30;
      allow delete: if isMe(uid);
    }
    // unique handle -> uid
    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // progress counts, readable by the owner and accepted friends only
    match /stats/{uid} {
      allow read: if isMe(uid) || (signedIn() && areFriends(request.auth.uid, uid));
      allow delete: if isMe(uid);
      // pts grows at a plausible rate only: a start allowance plus about 0.6 points per second since the last write.
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['stories','riddles','badges','ts','pts','rk','st','at'])
        && request.resource.data.stories is int && request.resource.data.riddles is int && request.resource.data.badges is int
        && (!('pts' in request.resource.data) || (
             request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 100000
             && request.resource.data.rk is int && request.resource.data.rk >= 0 && request.resource.data.rk <= 4
             && request.resource.data.st is int && request.resource.data.st >= 0 && request.resource.data.st <= 400
             && request.resource.data.at == request.time
             && (!exists(/databases/$(database)/documents/stats/$(uid)) || !('at' in resource.data) || !('pts' in resource.data)
                 ? request.resource.data.pts <= 6000
                 : request.resource.data.pts <= resource.data.pts + 500 + (request.time.toMillis() - resource.data.at.toMillis()) / 1700)));
    }
    // live location, only while the owner shares. Friends read. Owner deletes to hide.
    match /loc/{uid} {
      allow read: if isMe(uid) || (signedIn() && areFriends(request.auth.uid, uid));
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['lat','lon','ts'])
        && request.resource.data.lat is number && request.resource.data.lon is number;
      allow delete: if isMe(uid);
    }
    // friend requests: requests/{to}/from/{from}
    match /requests/{to}/from/{from} {
      allow create: if isMe(from) && from != to && request.resource.data.keys().hasOnly(['ts']) && !blockedEither(from, to);
      allow read, delete: if isMe(to) || isMe(from);
    }
    // friends/{uid}/list/{fid}: the accepter writes both sides after a pending request exists
    match /friends/{uid}/list/{fid} {
      allow read: if isMe(uid);
      allow create: if (isMe(uid) && exists(/databases/$(database)/documents/requests/$(uid)/from/$(fid)))
                    || (isMe(fid) && exists(/databases/$(database)/documents/requests/$(fid)/from/$(uid)));
      allow delete: if isMe(uid) || isMe(fid);
    }
    // 1:1 chat. Chat id is the two uids sorted and joined with an underscore.
    match /chats/{chatId}/messages/{mid} {
      function ids() { return chatId.split('_'); }
      function member() { return signedIn() && ids().size() == 2 && request.auth.uid in ids(); }
      function other() { return ids()[0] == request.auth.uid ? ids()[1] : ids()[0]; }
      function d() { return request.resource.data; }
      allow read: if member() && areFriends(request.auth.uid, other());
      allow create: if member() && areFriends(request.auth.uid, other()) && !blockedEither(request.auth.uid, other())
        && d().keys().hasOnly(['from','text','ts','img','au','ad','rep'])
        && d().from == request.auth.uid
        && d().text is string && d().text.size() <= 1000
        && (d().text.size() > 0 || ('img' in d() && d().img.size() > 0) || ('au' in d() && d().au.size() > 0))
        && (!('img' in d()) || (d().img is string && d().img.size() <= 160000))
        && (!('au' in d()) || (d().au is string && d().au.size() <= 210000 && d().ad is int && d().ad <= 60))
        && (!('rep' in d()) || (d().rep.keys().hasOnly(['id','t','f']) && d().rep.t is string && d().rep.t.size() <= 100))
        && d().ts == request.time;
      // sender: edit text or delete for everyone. Either member: reactions (rx) and delete-for-me (dl).
      allow update: if member() && areFriends(request.auth.uid, other()) && (
        (resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','ed','del','img','au'])
          && d().text is string && d().text.size() <= 1000)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx','dl'])
          && (!('rx' in d()) || d().rx.keys().hasOnly(ids()))
          && (!('dl' in d()) || (d().dl is list && d().dl.size() <= 2 && d().dl.hasOnly(ids())))));
    }
    // chat read receipts and typing indicator (members who are friends)
    match /chats/{chatId}/reads/{u} {
      function cm() { return signedIn() && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'); }
      function co() { return chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]; }
      allow read: if cm() && areFriends(request.auth.uid, co());
      allow create, update: if isMe(u) && cm() && areFriends(request.auth.uid, co()) && request.resource.data.keys().hasOnly(['ts']);
    }
    match /chats/{chatId}/deliv/{u} {
      function cm() { return signedIn() && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'); }
      function co() { return chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]; }
      allow read: if cm() && areFriends(request.auth.uid, co());
      allow create, update: if isMe(u) && cm() && areFriends(request.auth.uid, co()) && request.resource.data.keys().hasOnly(['ts']);
    }
    // private cloud backup of the owner's place photos (compressed JPEG data URLs)
    match /memories/{uid}/items/{id} {
      allow read, delete: if isMe(uid);
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['n','ts','v','img'])
        && request.resource.data.n is int && request.resource.data.ts is int && request.resource.data.v is int
        && request.resource.data.img is string && request.resource.data.img.size() <= 160000;
    }
    match /presence/{u} {
      allow read: if isMe(u) || (signedIn() && areFriends(request.auth.uid, u));
      allow create, update: if isMe(u) && request.resource.data.keys().hasOnly(['ts']) && request.resource.data.ts is int;
    }
    match /chats/{chatId}/typing/{u} {
      function cm() { return signedIn() && chatId.split('_').size() == 2 && request.auth.uid in chatId.split('_'); }
      function co() { return chatId.split('_')[0] == request.auth.uid ? chatId.split('_')[1] : chatId.split('_')[0]; }
      allow read: if cm() && areFriends(request.auth.uid, co());
      allow create, update: if isMe(u) && cm() && areFriends(request.auth.uid, co()) && request.resource.data.keys().hasOnly(['ts']);
    }
    // posts: userPosts/{uid}/items/{id}. Friends-only. Photos are compressed JPEG data URLs (no Storage needed).
    match /userPosts/{uid}/items/{id} {
      allow read: if isMe(uid) || (signedIn() && areFriends(request.auth.uid, uid));
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid','kind','text','img','n','title','ts'])
        && request.resource.data.uid == uid
        && request.resource.data.kind in ['photo','badge']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.img is string && request.resource.data.img.size() <= 260000
        && request.resource.data.ts == request.time;
      allow delete: if isMe(uid);
      match /likes/{liker} {
        allow read: if isMe(uid) || (signedIn() && areFriends(request.auth.uid, uid));
        allow create: if isMe(liker) && (liker == uid || areFriends(liker, uid));
        allow delete: if isMe(liker) || isMe(uid);
      }
      match /comments/{cid} {
        allow read: if isMe(uid) || (signedIn() && areFriends(request.auth.uid, uid));
        allow create: if signedIn() && (request.auth.uid == uid || areFriends(request.auth.uid, uid))
          && request.resource.data.keys().hasOnly(['uid','text','ts'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.ts == request.time;
        allow delete: if isMe(resource.data.uid) || isMe(uid);
      }
    }
    // blocks/{blocker}/list/{blocked}: the blocker manages the list. The blocked person can only check their own entry (used to hide the blocker from nearby results).
    match /blocks/{uid}/list/{bid} {
      allow get: if isMe(uid) || isMe(bid);
      allow list: if isMe(uid);
      allow create: if isMe(uid) && uid != bid && request.resource.data.keys().hasOnly(['ts']);
      allow delete: if isMe(uid);
    }
    // nearby: approximate (about 1 km) position of users who opted in, only while their app is open. Clients drop entries older than 10 minutes.
    match /nearby/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['lat','lon','ts'])
        && request.resource.data.lat is number && request.resource.data.lon is number;
      allow delete: if isMe(uid);
    }
    // 24h stories with audience control. The story document is readable only by its owner and by people who have a
    // storyFeed entry (written by the owner for each chosen viewer). Clients hide stories older than 24 hours.
    match /stories/{uid}/items/{id} {
      allow get: if isMe(uid) || (signedIn() && exists(/databases/$(database)/documents/storyFeed/$(request.auth.uid)/items/$(uid + '_' + id)));
      allow list: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid','img','cap','ts','dur','aud','mu','pl','sl'])
        && (!('pl' in request.resource.data) || (request.resource.data.pl.keys().hasOnly(['q','a','b']) && request.resource.data.pl.q is string && request.resource.data.pl.q.size() <= 60 && request.resource.data.pl.a is string && request.resource.data.pl.a.size() <= 25 && request.resource.data.pl.b is string && request.resource.data.pl.b.size() <= 25))
        && (!('sl' in request.resource.data) || (request.resource.data.sl.keys().hasOnly(['q','e']) && request.resource.data.sl.q is string && request.resource.data.sl.q.size() <= 60 && request.resource.data.sl.e is string && request.resource.data.sl.e.size() <= 8))
        && (!('mu' in request.resource.data) || (request.resource.data.mu is string && request.resource.data.mu.size() <= 10))
        && request.resource.data.uid == uid
        && request.resource.data.img is string && request.resource.data.img.size() <= 260000
        && request.resource.data.cap is string && request.resource.data.cap.size() <= 120
        && request.resource.data.dur is int && request.resource.data.dur >= 30 && request.resource.data.dur <= 60
        && request.resource.data.aud in ['all','close','except']
        && request.resource.data.ts == request.time;
      allow delete: if isMe(uid);
      match /views/{viewer} {
        allow create, update: if isMe(viewer) && exists(/databases/$(database)/documents/storyFeed/$(viewer)/items/$(uid + '_' + id))
          && request.resource.data.keys().hasOnly(['ts','rx','rp','pv','sv'])
          && (!('pv' in request.resource.data) || (request.resource.data.pv is int && request.resource.data.pv >= 0 && request.resource.data.pv <= 1))
          && (!('sv' in request.resource.data) || (request.resource.data.sv is int && request.resource.data.sv >= 0 && request.resource.data.sv <= 100))
          && (!('rx' in request.resource.data) || (request.resource.data.rx is string && request.resource.data.rx.size() <= 8))
          && (!('rp' in request.resource.data) || (request.resource.data.rp is string && request.resource.data.rp.size() <= 200));
        allow read: if isMe(uid) || isMe(viewer);
        allow delete: if isMe(uid);
      }
    }
    // storyFeed/{viewer}/items/{ownerUid_storyId}: one entry per allowed viewer, written by the story owner.
    match /storyFeed/{viewer}/items/{key} {
      allow read: if isMe(viewer);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['o','id','ts'])
        && request.resource.data.o == request.auth.uid
        && key == request.auth.uid + '_' + request.resource.data.id
        && areFriends(viewer, request.auth.uid) && !blockedEither(viewer, request.auth.uid);
      allow delete: if isMe(viewer) || isMe(resource.data.o);
    }
    // private close-friends list, only the owner can read or write it
    match /closeFriends/{uid} {
      allow read, write: if isMe(uid);
    }
    // reports: write only, read in the Firebase console
    match /reports/{rid} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','postUid','postId','reason','ts'])
        && request.resource.data.ts == request.time;
    }
    // suggested places: the owner creates and reads their own. Reviewed by Ahmed in the console.
    match /placeSuggestions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','name','note','lat','lon','src','lic','ts'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.ts == request.time;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
